<Application x:Class="RegularAudioTool.App" ThemeMode="Dark"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>

            <!-- ThemeMode loads the matching Fluent resources automatically. -->
<!-- ======================================= -->
            <!-- F1 THEME - Accent Brushes               -->
            <!-- ======================================= -->

            <!-- ListBox: Dateiliste links -->
            <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundThemeBrush" Color="#B8FF16" Opacity="0.35"/>

            <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundPointerOverThemeBrush" Color="#B8FF16" Opacity="0.50"/>

            <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundPressedThemeBrush" Color="#B8FF16" Opacity="0.60"/>    
        
            <SolidColorBrush x:Key="ListBoxItemSelectedForegroundThemeBrush" Color="#FFFFFF"/>

            <!-- DataGrid: Sound-Tabelle -->
            <SolidColorBrush x:Key="DataGridRowSelectedBackgroundThemeBrush" Color="#B8FF16" Opacity="0.65"/>

            <SolidColorBrush x:Key="DataGridRowSelectedForegroundThemeBrush" Color="#101010"/>

            <!-- ListView: Falls du ListView verwendest -->
            <SolidColorBrush x:Key="ListViewItemPillFillBrush" Color="#B8FF16"/>

            <!-- TreeView -->
            <SolidColorBrush x:Key="TreeViewItemSelectionIndicatorForeground" Color="#B8FF16"/>

            <!-- ProgressBar -->
            <SolidColorBrush x:Key="ProgressBarForeground" Color="#B8FF16"/>

            <!-- TextBox-Fokus -->
            <SolidColorBrush x:Key="TextBoxBorderBrushFocused" Color="#B8FF16"/>

            <!-- Slider -->
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#B8FF16"/>
            
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#D0FF60"/>

            <!-- Checkbox -->
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#B8FF16"/>
            
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#D0FF60"/>

            <!-- Accent Buttons -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#B8FF16"/>

            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#D0FF60"/>

        </ResourceDictionary>
    </Application.Resources>
</Application>
